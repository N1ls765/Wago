# Kopieren nach .env.local und anpassen (.env.local wird nicht eingecheckt)

# Ziel des Dev-Proxys '/aas' (Standard: lokaler BaSyx-Server aus ../aas-server)
# AAS_PROXY_TARGET=http://localhost:8081

# Statt Proxy direkt einen AAS-Server ansprechen (muss CORS erlauben)
# VITE_AAS_URL=http://localhost:8081
